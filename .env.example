NEXT_PUBLIC_SITE_URL=http://localhost:3000

# https://www.vworld.kr 에서 발급받은 API 키를 입력하세요.
NEXT_PUBLIC_VWORLD_API_KEY=여기에-브이월드-API-키-입력

# https://www.data.go.kr/data/15013104/openapi.do 에서 발급받은 일반 인증키(Decoding)를 입력하세요.
# tools/data-builder/build-festival.ts 빌드타임 전용 — 클라이언트에 노출되지 않습니다.
DATA_GO_KR_FESTIVAL_KEY=여기에-data.go.kr-축제API-키-입력

# (선택) Google Tag Manager 컨테이너 ID. 예: GTM-XXXXXXX
# 비워두면 태그를 주입하지 않습니다. 프로덕션 빌드에서만 로드됩니다.
NEXT_PUBLIC_GTM_ID=
